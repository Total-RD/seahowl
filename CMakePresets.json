{
  "version": 2,
  "vendor": {
    "seahowl": {}
  },
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default SEAHOWL installation",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/external/vcpkg"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "default/debug",
      "inherits": "default",
      "displayName": "Default SEAHOWL installation (Debug)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "full",
      "inherits": "default",
      "displayName": "Full SEAHOWL installation",
      "cacheVariables": {
        "SEAHOWL_ENABLE_BUILD": "ON",
        "SEAHOWL_ENABLE_TESTS": "ON",
        "SEAHOWL_ENABLE_EXAMPLES": "ON",
        "SEAHOWL_ENABLE_PYTHON": "ON",
        "SEAHOWL_ENABLE_VIRTUALENV": "ON",
        "SEAHOWL_ENABLE_HYDROCHRONO": "ON",
        "SEAHOWL_ENABLE_AERODYN": "ON",
        "SEAHOWL_ENABLE_INFLOWWIND": "ON",
        "SEAHOWL_ENABLE_IRRLICHT": "OFF",
        "SEAHOWL_ENABLE_VTK": "OFF",
        "SEAHOWL_ENABLE_DOC": "OFF"
      }
    },
    {
      "name": "full/debug",
      "inherits": [
        "debug",
        "full"
      ],
      "displayName": "Full SEAHOWL installation (Debug)"
    },
    {
      "name": "full_viz",
      "inherits": "full",
      "displayName": "Full SEAHOWL installation with in situ visualization",
      "cacheVariables": {
        "SEAHOWL_ENABLE_IRRLICHT": "ON"
      }
    },
    {
      "name": "full_viz/debug",
      "inherits": [
        "debug",
        "full_viz"
      ],
      "displayName": "Full SEAHOWL installation with in situ visualization (Debug)"
    },
    {
      "name": "full_vtk",
      "inherits": "full_viz",
      "displayName": "Full SEAHOWL installation with VTK and in situ visualization",
      "cacheVariables": {
        "SEAHOWL_ENABLE_IRRLICHT": "ON",
        "SEAHOWL_ENABLE_VTK": "ON"
      }
    },
    {
      "name": "full_vtk/debug",
      "inherits": [
        "debug",
        "full_vtk"
      ],
      "displayName": "Full SEAHOWL installation with VTK and in situ visualization (Debug)"
    },
    {
      "name": "minimal",
      "displayName": "Minimal SEAHOWL installation",
      "inherits": "default",
      "cacheVariables": {
        "SEAHOWL_ENABLE_BUILD": "ON",
        "SEAHOWL_ENABLE_TESTS": "OFF",
        "SEAHOWL_ENABLE_EXAMPLES": "OFF",
        "SEAHOWL_ENABLE_PYTHON": "OFF",
        "SEAHOWL_ENABLE_HYDROCHRONO": "OFF",
        "SEAHOWL_ENABLE_AERODYN": "OFF",
        "SEAHOWL_ENABLE_INFLOWWIND": "OFF",
        "SEAHOWL_ENABLE_VTK": "OFF",
        "SEAHOWL_ENABLE_DOC": "OFF"
      }
    },
    {
      "name": "minimal/debug",
      "inherits": [
        "debug",
        "minimal"
      ],
      "displayName": "Minimal SEAHOWL installation (Debug)"
    }
  ]
}
