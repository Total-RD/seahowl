{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/build/.venv/bin/python",
            "program": "${input:mainInputScript}",
            "console": "integratedTerminal",
            "env": {
                    "PYTHONPATH": "${workspaceFolder}/build/debug"
            }
        },
        {
            "name": "Launch C++ (gdb) ",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "${input:mainInputFile}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: Debug with C++ (pybind11)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/.venv/bin/python",
            "args": [
                "${input:mainInputScript}"
            ],
            "cwd": "${input:mainInputWorkingDirectory}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build/debug"
                }
            ],
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "mainInputFile",
            "description": "Set specific main input file to be launched",
            "default": "",
            "type": "promptString"
        },
        {
            "id": "mainInputScript",
            "description": "Set specific main input script to be launched",
            "default": "",
            "type": "promptString"
        },
        {
            "id": "mainInputWorkingDirectory",
            "description": "Set specific main input working directory to be launched",
            "default": "",
            "type": "promptString"
        }
    ]
}
